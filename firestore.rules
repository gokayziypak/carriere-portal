rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Client listesi, sohbet, loglar, bildirimler: giriş yapmış herkes okuyup yazabilir.
    match /appdata/{docId} {
      allow read, write: if request.auth != null;
    }

    // Üye profilleri: herkes okuyabilir; bir kullanıcı sadece kendi profilini,
    // ya da rolü "Yönetici" olan biri herhangi bir profili güncelleyebilir/silebilir.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Yönetici'
      );
    }
  }
}
